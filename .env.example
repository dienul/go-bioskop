# Isi DATABASE_URL jika menggunakan Railway. Biarkan kosong untuk PostgreSQL lokal.
DATABASE_URL=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_bioskop
DB_SSLMODE=disable

# Railway akan memberikan PORT secara otomatis. Untuk lokal, nilai default-nya 8080.
PORT=8080
